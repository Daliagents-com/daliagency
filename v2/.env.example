# --- Vercel Web Analytics ---
# Enable Web Analytics in the Vercel project dashboard (Analytics tab).
# Client pageviews ship via FunnelAnalytics when deployed on Vercel.
# Custom events use @vercel/analytics track() - no extra env required.

# --- ClickHouse (custom product analytics) ---
# Create a service in ClickHouse Cloud, run src/lib/analytics/schema.sql,
# then set these on Vercel (Production + Preview as needed).
#
# Prefer full URL from the Cloud "Connect" dialog:
#   CLICKHOUSE_URL=https://xxx.eu-west-1.aws.clickhouse.cloud:8443
# Or host only (https assumed if scheme missing is not auto-added - use full URL):
CLICKHOUSE_URL=
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
# Optional table override (default: web_events)
CLICKHOUSE_EVENTS_TABLE=web_events

# Shared secret for /internal/analytics (min 12 chars). Not the ClickHouse password.
ANALYTICS_DASHBOARD_SECRET=

# --- Consultation delivery (existing) ---
# CONSULTATION_WEBHOOK_URL=
# RESEND_API_KEY=
# CONSULTATION_FROM_EMAIL=
